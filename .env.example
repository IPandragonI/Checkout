# Copy to .env.local (and add the same variables in Vercel → Project → Settings → Environment Variables).
# All are optional: without them the app runs fully offline (solo + pass-and-play, local stats).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Newer projects can use the publishable key instead of the anon key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OAuth buttons to show on the account page (comma-separated: google, github).
# Enable each provider in Supabase → Authentication → Providers first. Leave empty for email/password only.
NEXT_PUBLIC_AUTH_PROVIDERS=google
